{
	"name": "sokos-utbetalingsportalen",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"astro": "astro",
		"dev:server": "concurrently \"astro dev --host 0.0.0.0\" \"tsx mock/server.ts\"",
		"dev": "pnpm dev:server",
		"mock:sync-oauth-config": "tsx mock/auth/generate-oauth-config.ts",
		"dev:mock": "pnpm mock:sync-oauth-config && docker compose up -d && dotenv -e .env.template -- pnpm dev:server",
		"dev:mock:down": "docker compose down",
		"build": "astro check && astro build",
		"vitest": "vitest",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"prettier:format": "prettier --write '**/*.astro'",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/node": "11.1.4",
		"@astrojs/react": "6.0.4",
		"@nais/apm": "0.6.0",
		"@navikt/aksel-icons": "8.15.0",
		"@navikt/ds-react": "8.15.0",
		"@navikt/oasis": "4.1.4",
		"@opentelemetry/sdk-node": "0.221.0",
		"@prometheus-io/client": "0.16.0",
		"astro": "7.2.6",
		"pino": "10.3.1",
		"pino-socket": "8.0.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@hono/node-server": "2.1.1",
		"@navikt/aksel-stylelint": "8.15.0",
		"@types/node": "26.3.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"concurrently": "10.0.5",
		"dotenv-cli": "11.0.0",
		"hono": "4.13.4",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"stylelint": "17.14.1",
		"stylelint-config-standard": "40.0.0",
		"tsx": "4.23.12",
		"typescript": "6.0.3",
		"vitest": "4.1.11"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.astro": "prettier --write",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.22.0",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
