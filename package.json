{
	"name": "sokos-utbetalingsportalen",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"astro": "astro",
		"dev": "astro dev",
		"dev:mock": "concurrently \"pnpm dev\" \"tsx mock/server.ts\"",
		"build": "astro check && astro build",
		"vitest": "vitest",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"prettier:format": "prettier --write '**/*.astro'",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/node": "11.0.3",
		"@astrojs/react": "6.0.2",
		"@nais/apm": "0.4.0",
		"@navikt/aksel-icons": "8.15.0",
		"@navikt/ds-react": "8.15.0",
		"@navikt/oasis": "4.1.4",
		"@opentelemetry/sdk-node": "0.221.0",
		"astro": "7.1.6",
		"pino": "10.3.1",
		"pino-socket": "8.0.0",
		"prom-client": "15.1.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@hono/node-server": "2.1.0",
		"@navikt/aksel-stylelint": "8.15.0",
		"@types/node": "26.1.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"concurrently": "10.0.4",
		"hono": "4.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"stylelint": "17.14.1",
		"stylelint-config-standard": "40.0.0",
		"tsx": "4.23.5",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.astro": "prettier --write",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.20.0",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
