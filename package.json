{
	"name": "sokos-utbetalingsportalen",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"astro": "astro",
		"dev:server": "concurrently \"astro dev --host 0.0.0.0\" \"tsx mock/server.ts\"",
		"dev": "pnpm dev:server",
		"mock:sync-oauth-config": "tsx mock/auth/generate-oauth-config.ts",
		"dev:mock": "pnpm mock:sync-oauth-config && docker compose up -d && dotenv -e .env.template -- pnpm dev:server",
		"dev:mock:down": "docker compose down",
		"build": "astro check && astro build",
		"vitest": "vitest",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"prettier:format": "prettier --write '**/*.astro'",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/node": "11.1.7",
		"@astrojs/react": "7.0.1",
		"@nais/apm": "0.7.3",
		"@navikt/aksel-icons": "8.18.0",
		"@navikt/ds-react": "8.18.0",
		"@navikt/oasis": "4.2.2",
		"@opentelemetry/sdk-node": "0.223.0",
		"@prometheus-io/client": "0.16.1",
		"astro": "7.3.7",
		"pino": "10.4.0",
		"pino-socket": "8.0.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@hono/node-server": "2.1.3",
		"@navikt/aksel-stylelint": "8.18.0",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"concurrently": "10.0.5",
		"dotenv-cli": "11.0.0",
		"hono": "4.13.13",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.9",
		"prettier-plugin-astro": "1.1.0",
		"stylelint": "17.16.0",
		"stylelint-config-standard": "40.0.0",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"vitest": "5.0.3"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.astro": "prettier --write",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.28.3",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.28.3+sha512.d49760a13b1755948775a5d4cb1bc4ba871ff2dc941adf851630d044ed722f9b5be8be57bef93166098c80c706bd612c282d05526dd1d0ae660188c086820f35"
}
