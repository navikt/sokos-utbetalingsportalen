{
	"name": "sokos-utbetalingsportalen",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"astro": "astro",
		"dev:server": "concurrently \"astro dev --host 0.0.0.0\" \"tsx mock/server.ts\"",
		"dev": "pnpm dev:server",
		"mock:sync-oauth-config": "tsx mock/auth/generate-oauth-config.ts",
		"dev:mock": "pnpm mock:sync-oauth-config && docker compose up -d && dotenv -e .env.template -- pnpm dev:server",
		"dev:mock:down": "docker compose down",
		"build": "astro check && astro build",
		"vitest": "vitest",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"prettier:format": "prettier --write '**/*.astro'",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@astrojs/check": "0.9.12",
		"@astrojs/node": "11.1.9",
		"@astrojs/react": "7.1.2",
		"@nais/apm": "0.7.3",
		"@navikt/aksel-icons": "8.20.1",
		"@navikt/ds-react": "8.20.1",
		"@navikt/oasis": "4.2.2",
		"@opentelemetry/api": "1.10.0",
		"@prometheus-io/client": "0.16.1",
		"astro": "7.4.5",
		"pino": "10.4.0",
		"pino-socket": "8.0.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@hono/node-server": "2.1.6",
		"@navikt/aksel-stylelint": "8.20.1",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"concurrently": "10.0.6",
		"dotenv-cli": "11.1.0",
		"hono": "4.13.16",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"stylelint": "17.16.0",
		"stylelint-config-standard": "40.0.0",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.astro": "prettier --write",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.28.10",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.28.10+sha512.672216f06e15c109b85471d49d3fbed17e6f03ead258df08c2bf5b4a5c33321ebfbf59476bce81325efada16ace0ac78548fd0bfcd7a51369e939182a3dd50e4"
}
